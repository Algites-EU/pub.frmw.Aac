{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Simple Audit Configuration 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Output": {
      "type": "object",
      "default": {
        "Type": "stdout"
      },
      "x-aac-name": {
        "Text": "Output",
        "ResourceKey": "aac.simpleaudit.config.output.name"
      },
      "x-aac-description": {
        "Text": "Selects where audit records are written.",
        "ResourceKey": "aac.simpleaudit.config.output.description"
      },
      "additionalProperties": false,
      "properties": {
        "Type": {
          "enum": [
            "stdout",
            "file"
          ],
          "default": "stdout",
          "x-aac-name": {
            "Text": "Output type",
            "ResourceKey": "aac.simpleaudit.config.output.type.name"
          }
        },
        "Path": {
          "type": "string",
          "minLength": 1,
          "x-aac-name": {
            "Text": "File path",
            "ResourceKey": "aac.simpleaudit.config.output.path.name"
          }
        }
      },
      "required": [
        "Type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "Type": {
                "const": "file"
              }
            },
            "required": [
              "Type"
            ]
          },
          "then": {
            "required": [
              "Path"
            ]
          }
        }
      ]
    },
    "Format": {
      "enum": [
        "json",
        "text"
      ],
      "default": "json",
      "x-aac-name": {
        "Text": "Format",
        "ResourceKey": "aac.simpleaudit.config.format.name"
      },
      "x-aac-description": {
        "Text": "Selects the serialized audit-record format.",
        "ResourceKey": "aac.simpleaudit.config.format.description"
      }
    }
  },
  "x-aac-schema-id": "simpleaudit-config",
  "x-aac-schema-version": 1
}
