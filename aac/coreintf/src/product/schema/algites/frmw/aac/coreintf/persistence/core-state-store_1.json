            "record_revision",
            "payload"
          ],
          "additionalProperties": false,
          "properties": {
            "record_revision": {
              "$ref": "../common/persistence/record-revision-monotonic-integer_1.json"
            },
            "payload": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.core-state-store",
  "x-aac-schema-version": 1
}
