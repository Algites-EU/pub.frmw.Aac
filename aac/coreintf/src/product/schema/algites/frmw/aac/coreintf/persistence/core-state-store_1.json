{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.core-state-store/1",
  "title": "AAC Core State Store 1",
  "type": "object",
  "required": [
    "format_version",
    "revision_kind",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
