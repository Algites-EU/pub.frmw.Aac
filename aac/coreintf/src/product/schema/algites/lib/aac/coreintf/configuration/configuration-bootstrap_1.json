{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Configuration Bootstrap 1",
  "type": "object",
  "required": [
    "configuration_bootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "configuration_bootstrap": {
      "type": "object",
      "required": [
        "schema_version",
        "default_configuration_profile",
        "configuration_profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "default_configuration_profile": {
          "type": "string",
          "minLength": 1
        },
        "workspace_configuration_profiles": {
          "enum": [
            "FORBIDDEN",
            "ALLOWED",
            "ALLOWED_IF_SIGNED"
          ]
        },
        "mandatory_configuration_scope_definition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configuration_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "configuration_scopes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "configuration_scopes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "resolver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resolver": {
                      "type": "string",
                      "minLength": 1
                    },
                    "policy_authority": {
                      "type": "boolean"
                    },
                    "mandatory": {
                      "type": "boolean"
                    },
                    "configuration_providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "priority": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "description": {
                      "$ref": "#/$defs/displayText"
                    }
                  }
                }
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "configuration_providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "authentication_profile_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "configuration_scope_resolvers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        },
        "configuration_profile_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "uri"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "authentication_profile_id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "resource_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "resource_key"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.configuration-bootstrap",
  "x-aac-schema-version": 1
}
