{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Capability Contract 1",
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "resource_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "resource_key"
              ]
            }
          ]
        }
      ]
    },
    "authorizationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "any_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "all_of"
          ]
        },
        {
          "required": [
            "any_of"
          ]
        }
      ]
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "type": "object",
  "required": [
    "capability",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "object",
      "required": [
        "id",
        "version",
        "group_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "$ref": "#/$defs/displayText"
        },
        "description": {
          "$ref": "#/$defs/displayText"
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorization_permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/$defs/displayText"
          },
          "description": {
            "$ref": "#/$defs/displayText"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "$ref": "#/$defs/displayText"
          },
          "description": {
            "$ref": "#/$defs/displayText"
          },
          "authorization": {
            "$ref": "#/$defs/authorizationRequirement"
          },
          "sensitive_input_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "sensitive_output_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "metadata": {
            "type": "object"
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "schema"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "INPUT",
                    "RUNNING_COMPLETE_STATE_RESULT",
                    "RUNNING_DELTA_STATE_RESULT",
                    "FINAL_SUCCESS_STATE_RESULT",
                    "FINAL_CANCELLED_STATE_RESULT",
                    "FINAL_FAILED_STATE_RESULT_EXTENSION"
                  ]
                },
                "schema": {
                  "$ref": "#/$defs/schemaRef"
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "x-aac-schema-id": "_AAC.schema.capability-contract",
  "x-aac-schema-version": 1
}
