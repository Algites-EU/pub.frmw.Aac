{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Provider Instance 1",
  "type": "object",
  "required": [
    "id",
    "component_id",
    "provider_definition_id",
    "name",
    "capabilities",
    "access_mode",
    "implementation_class"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "implementation_class": {
      "type": "string",
      "minLength": 1
    },
    "configuration_schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "configuration": {
      "type": "object"
    },
    "state": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "access_mode": {
      "enum": [
        "READ_ONLY",
        "READ_WRITE"
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.provider-instance",
  "x-aac-schema-version": 1
}
