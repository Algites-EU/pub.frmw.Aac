{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Security Bootstrap 1",
  "type": "object",
  "required": [
    "security_bootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "security_bootstrap": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "secret_providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "bootstrap_safe": {
                "type": "boolean"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "authentication_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "mechanism"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "secret_reference"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "secret_reference": {
                          "type": "object",
                          "required": [
                            "secret_provider_id",
                            "key"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "secret_provider_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "metadata": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "metadata": {
                "type": "object"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "resource_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "resource_key"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.security-bootstrap",
  "x-aac-schema-version": 1
}
