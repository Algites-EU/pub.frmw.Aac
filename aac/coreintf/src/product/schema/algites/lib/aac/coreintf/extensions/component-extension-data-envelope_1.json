{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Component Extension Data Envelope 1",
  "type": "object",
  "required": ["owner_component_id", "component_extension_schema", "written_by_component_version", "core_entity", "payload"],
  "additionalProperties": false,
  "properties": {
    "owner_component_id": {"type": "string", "minLength": 1},
    "component_extension_schema": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "written_by_component_version": {"type": "integer", "minimum": 1},
    "core_entity": {
      "type": "object",
      "required": ["entity_type_id", "entity_id"],
      "additionalProperties": false,
      "properties": {
        "entity_type_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1}
      }
    },
    "payload_format": {"type": "string", "minLength": 1, "default": "NORMALIZED"},
    "payload": {},
    "metadata": {"type": "object"}
  }
}
