{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-envelope",
  "x-aac-schema-version": 1,
  "title": "AAC Data Entity Envelope 1",
  "type": "object",
  "required": [
    "uid",
    "schema_id",
    "schema_version",
    "record_revision",
    "state",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "uid": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "record_revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "state": {
      "enum": [
        "ACTIVE",
        "TOMBSTONE"
      ]
    },
    "payload": {}
  }
}
