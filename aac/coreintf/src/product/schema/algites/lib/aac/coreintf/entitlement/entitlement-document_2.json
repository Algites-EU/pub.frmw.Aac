{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Document 2",
  "type": "object",
  "required": [
    "entitlement"
  ],
  "additionalProperties": false,
  "properties": {
    "entitlement": {
      "type": "object",
      "required": [
        "format_version",
        "entitlement_id",
        "issuer",
        "licensing_scope",
        "subject",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": 2
        },
        "entitlement_id": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "subject": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string"
            },
            "attributes": {
              "type": "object"
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "grants"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "capability",
                    "permissions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "capability": {
                      "type": "object",
                      "required": [
                        "id",
                        "version"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "valid_from": {
                            "type": "string"
                          },
                          "valid_until": {
                            "type": "string"
                          },
                          "constraints": {
                            "type": "object"
                          },
                          "metadata": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "issued_at": {
          "type": "string"
        },
        "valid_from": {
          "type": "string"
        },
        "valid_until": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "issued_for_request": {
          "type": "object",
          "required": [
            "request_id",
            "request_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "minLength": 1
            },
            "request_digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "licensing_scope": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
