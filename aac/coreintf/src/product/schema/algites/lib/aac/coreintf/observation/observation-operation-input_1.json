{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Observation Operation Input 1",
  "type": "object",
  "properties": {
    "observation_input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "AAC Observation Input 1",
      "type": "object",
      "required": [
        "invocation_id",
        "phase",
        "capability_id",
        "capability_version",
        "operation_id",
        "provider_instance_id"
      ],
      "properties": {
        "invocation_id": {
          "type": "string"
        },
        "parent_invocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "enum": [
            "PRE",
            "POST"
          ]
        },
        "capability_id": {
          "type": "string"
        },
        "capability_version": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "type": "string"
        },
        "provider_instance_id": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "outcome": {
          "enum": [
            "SUCCESS",
            "ERROR",
            null
          ]
        },
        "result": {},
        "error": {
          "type": [
            "object",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  },
  "required": [
    "observation_input"
  ],
  "additionalProperties": false
}
