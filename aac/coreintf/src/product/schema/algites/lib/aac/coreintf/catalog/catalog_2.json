{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "catalog"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "type": "object",
      "required": [
        "format_version",
        "product_id",
        "technology_id",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "const": 2
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "technology_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "resource_key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "permission": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/displayText"
        },
        "description": {
          "$ref": "#/$defs/displayText"
        },
        "possible_entitlement_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "capabilityEntitlement": {
      "type": "object",
      "required": [
        "capability",
        "permissions"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "name": {
          "$ref": "#/$defs/displayText"
        },
        "description": {
          "$ref": "#/$defs/displayText"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "locator",
        "artifact_filename",
        "package_format",
        "descriptor_path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "URI",
                "REPOSITORY"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "repository_id": {
              "type": "string",
              "minLength": 1
            },
            "coordinates": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "URI"
                  }
                }
              },
              "then": {
                "required": [
                  "uri"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "REPOSITORY"
                  }
                }
              },
              "then": {
                "required": [
                  "repository_id"
                ]
              }
            }
          ]
        },
        "artifact_filename": {
          "type": "string",
          "minLength": 1
        },
        "package_format": {
          "type": "string",
          "minLength": 1
        },
        "descriptor_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "runtime_package": {
          "type": "string",
          "minLength": 1
        },
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata": {
          "type": "object"
        },
        "authentication_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "sidecars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "suffix"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "suffix": {
                "type": "string",
                "pattern": "^\\..+"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "type": "string",
          "minLength": 1
        },
        "release_notes_url": {
          "type": "string",
          "minLength": 1
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "versions"
            ],
            "additionalProperties": false,
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "capability"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "versions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "cardinality": {
                "enum": [
                  "SINGLE",
                  "MULTIPLE"
                ]
              },
              "mandatory": {
                "type": "boolean"
              }
            }
          }
        },
        "capability_entitlements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityEntitlement"
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "metadata": {
          "type": "object"
        },
        "persistent_schemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persistentSchema"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "component_id",
        "releases"
      ],
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/displayText"
        },
        "description": {
          "$ref": "#/$defs/displayText"
        },
        "publisher": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "$ref": "#/$defs/displayText"
            }
          }
        },
        "homepage_url": {
          "type": "string",
          "minLength": 1
        },
        "documentation_url": {
          "type": "string",
          "minLength": 1
        },
        "support_url": {
          "type": "string",
          "minLength": 1
        },
        "entitlement_info_url": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "object",
          "required": [
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "persistentSchema": {
      "type": "object",
      "required": [
        "kind",
        "schema_id",
        "write_version"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "COMPONENT_CONFIGURATION",
            "PROVIDER_CONFIGURATION",
            "ENTITY_EXTENSION"
          ]
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "write_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "COMPONENT_CONFIGURATION"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "owner_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "PROVIDER_CONFIGURATION",
                  "ENTITY_EXTENSION"
                ]
              }
            }
          },
          "then": {
            "required": [
              "owner_id"
            ]
          }
        }
      ]
    }
  }
}
