                      <xs:annotation>
                        <xs:documentation>Lists the readable versions supported or selected by this persisted schema.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Item" minOccurs="1" maxOccurs="unbounded">
