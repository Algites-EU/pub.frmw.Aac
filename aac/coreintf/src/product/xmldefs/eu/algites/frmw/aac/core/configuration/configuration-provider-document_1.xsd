  <xs:element name="ConfigurationProviderDocument">
    <xs:annotation>
      <xs:documentation>Defines the canonical AAC Configuration Provider Document schema and its serialized data contract.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FormatVersion" type="xs:anyType">
          <xs:annotation>
            <xs:documentation>Version of the persisted or exchanged document format.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ConfigurationScope">
          <xs:annotation>
            <xs:documentation>Scope within which this configuration document applies.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Type">
                <xs:annotation>
                  <xs:documentation>Type discriminator for this configuration scope.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Id" minOccurs="0" nillable="true" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Stable identifier of this configuration scope.</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="ConfigurationTarget">
          <xs:annotation>
            <xs:documentation>Identifies the component, provider, or scope targeted by this persisted configuration.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Kind" type="xs:anyType">
                <xs:annotation>
                  <xs:documentation>Kind of this configuration target.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ComponentId">
                <xs:annotation>
                  <xs:documentation>Stable identifier of the AAC component associated with this configuration target.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ProviderInstanceId" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Stable identifier of the provider instance associated with this configuration target.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Payload">
          <xs:annotation>
            <xs:documentation>Canonical payload carried by this AAC configuration provider document.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ConfigurationSchemaId">
                <xs:annotation>
                  <xs:documentation>Stable identifier of the configuration schema associated with this payload.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ConfigurationSchemaVersion">
                <xs:annotation>
                  <xs:documentation>Version of the configuration schema associated with this payload.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="WrittenByComponentVersion">
                <xs:annotation>
                  <xs:documentation>Component version that last wrote this persisted configuration payload.</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Values">
                <xs:annotation>
                  <xs:documentation>Configuration values stored for the target.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="MapEntry" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
                        </xs:sequence>
                        <xs:attribute name="key" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Policies">
                <xs:annotation>
                  <xs:documentation>Configuration policies stored with the effective values.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="MapEntry" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
                        </xs:sequence>
                        <xs:attribute name="key" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Metadata" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Additional structured metadata associated with this payload.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="MapEntry" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax"/>
                        </xs:sequence>
