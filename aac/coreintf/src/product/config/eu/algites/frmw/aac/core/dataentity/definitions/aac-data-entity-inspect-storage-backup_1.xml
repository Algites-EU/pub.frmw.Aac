          <Value>"aac.data.entity.inspect.storage.backup.operation.inspect.backup.name"</Value>
        </MapEntry>
      </Name>
      <Description>
        <MapEntry key="Text">
          <Value>"Inspects and validates one provider-specific physical backup file without modifying provider data."</Value>
