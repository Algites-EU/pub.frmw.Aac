<?xml version='1.0' encoding='UTF-8'?>
<CapabilityContract xmlns="https://defs.dev.algites.eu/api/xmldefs/eu/algites/frmw/aac/core/capability/capability-contract_1.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://defs.dev.algites.eu/api/xmldefs/eu/algites/frmw/aac/core/capability/capability-contract_1.xsd https://defs.dev.algites.eu/api/xmldefs/eu/algites/frmw/aac/core/capability/capability-contract_1.xsd" schemaRef="https://defs.dev.algites.eu/api/xmldefs/eu/algites/frmw/aac/core/capability/capability-contract_1.xsd">
  <Capability>
    <Id>_AAC.capability.observation</Id>
    <Version>1</Version>
    <Name>
      <MapEntry key="Text">
        <Value>"Capability invocation observation"</Value>
      </MapEntry>
      <MapEntry key="ResourceKey">
        <Value>"aac.capability.observation.name"</Value>
      </MapEntry>
    </Name>
    <Description>
      <MapEntry key="Text">
        <Value>"Observes normalized capability invocations before and after provider execution."</Value>
      </MapEntry>
      <MapEntry key="ResourceKey">
        <Value>"aac.capability.observation.description"</Value>
      </MapEntry>
    </Description>
    <GroupId>_AAC.runtime.observation</GroupId>
  </Capability>
  <Operations>
    <Item>
      <Id>observe</Id>
      <Name>
        <MapEntry key="Text">
          <Value>"Observe invocation"</Value>
        </MapEntry>
        <MapEntry key="ResourceKey">
          <Value>"aac.capability.observation.operation.observe.name"</Value>
        </MapEntry>
      </Name>
      <Description>
        <MapEntry key="Text">
          <Value>"Delivers one normalized PRE or POST capability invocation observation to the observer."</Value>
        </MapEntry>
        <MapEntry key="ResourceKey">
          <Value>"aac.capability.observation.operation.observe.description"</Value>
        </MapEntry>
      </Description>
      <Interactions>
        <Item>
          <Kind>input</Kind>
          <Schema>
            <Id>_AAC.schema.observation-input</Id>
            <Version>1</Version>
          </Schema>
        </Item>
        <Item>
          <Kind>final_success_state_result</Kind>
          <Schema>
            <Id>_AAC.schema.observation-output</Id>
            <Version>1</Version>
          </Schema>
        </Item>
      </Interactions>
    </Item>
  </Operations>
</CapabilityContract>
