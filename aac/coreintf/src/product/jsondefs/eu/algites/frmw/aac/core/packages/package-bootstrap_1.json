{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.package-bootstrap/1",
  "type": "object",
  "required": [
    "PackageBootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "PackageBootstrap": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Layout"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": {
          "const": 1
        },
        "Layout": {
          "type": "object",
          "required": [
            "ProductRoot"
          ],
          "additionalProperties": false,
          "properties": {
            "ProductRoot": {
              "type": "string",
              "minLength": 1
            },
            "PackageStoreSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "plugins"
            },
            "DownloadedSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "downloaded"
            },
            "InstalledSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "installed"
            },
            "ObsoleteSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "obsolete"
            },
            "CoreStateSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "aac-state"
            },
            "TransactionsSubdirectory": {
              "type": "string",
              "minLength": 1,
              "default": "transactions"
            },
            "CoreLockFilename": {
              "type": "string",
              "minLength": 1,
              "default": "core.lock"
            }
          }
        },
        "Sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Uri"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1,
                "default": "MANIFEST"
              },
              "Uri": {
                "type": "string",
                "minLength": 1
              },
              "AuthenticationProfileId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "VerifierId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Priority": {
                "type": "integer",
                "default": 0
              },
              "Settings": {
                "type": "object"
              },
              "Name": {},
              "Description": {}
            }
          }
        },
        "AutomationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "VerifyOnDownload": {
              "type": "boolean",
              "default": true
            },
            "RequireEntitlementForAutomaticPaidComponent": {
              "type": "boolean",
              "default": true
            },
            "AllowAutomaticDownload": {
              "type": "boolean",
              "default": true
            },
            "AllowAutomaticInstall": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "Metadata": {
          "type": "object"
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.package-bootstrap",
  "x-aac-schema-version": 1
}
