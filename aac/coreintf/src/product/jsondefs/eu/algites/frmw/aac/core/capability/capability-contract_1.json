{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Capability Contract 1",
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    },
    "authorizationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "AllOf": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "AnyOf": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "AllOf"
          ]
        },
        {
          "required": [
            "AnyOf"
          ]
        }
      ]
    },
    "schemaRef": {
      "type": "object",
      "required": [
        "Id",
        "Version"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "type": "object",
  "required": [
    "Capability",
    "Operations"
  ],
  "additionalProperties": false,
  "properties": {
    "Capability": {
      "type": "object",
      "required": [
        "Id",
        "Version",
        "GroupId"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "minimum": 1
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "GroupId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AuthorizationPermissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Id"
        ],
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1
          },
          "Name": {
            "$ref": "#/$defs/displayText"
          },
          "Description": {
            "$ref": "#/$defs/displayText"
          },
          "Metadata": {
            "type": "object"
          }
        }
      }
    },
    "Operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id"
        ],
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1
          },
          "Name": {
            "$ref": "#/$defs/displayText"
          },
          "Description": {
            "$ref": "#/$defs/displayText"
          },
          "Authorization": {
            "$ref": "#/$defs/authorizationRequirement"
          },
          "SensitiveInputPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "SensitiveOutputPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "Metadata": {
            "type": "object"
          },
          "Interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "Kind",
                "Schema"
              ],
              "additionalProperties": false,
              "properties": {
                "Kind": {
                  "enum": [
                    "input",
                    "running_complete_state_result",
                    "running_delta_state_result",
                    "final_success_state_result",
                    "final_cancelled_state_result",
                    "final_failed_state_result_extension"
                  ]
                },
                "Schema": {
                  "$ref": "#/$defs/schemaRef"
                }
              }
            }
          }
        }
      }
    },
    "Metadata": {
      "type": "object"
    }
  },
  "x-aac-schema-id": "_AAC.schema.capability-contract",
  "x-aac-schema-version": 1
}
