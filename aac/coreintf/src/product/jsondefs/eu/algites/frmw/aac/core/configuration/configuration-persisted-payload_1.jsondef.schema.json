{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Configuration Persisted Payload 1",
  "type": "object",
  "required": [
    "ConfigurationTarget",
    "ConfigurationSchema",
    "WrittenByComponentVersion",
    "Values",
    "Policies"
  ],
  "additionalProperties": false,
  "properties": {
    "ConfigurationTarget": {
      "type": "object",
      "required": [
        "Kind",
        "ComponentId"
      ],
      "additionalProperties": false,
      "properties": {
        "Kind": {
          "enum": [
            "component",
            "provider_instance"
          ]
        },
        "ComponentId": {
          "type": "string",
          "minLength": 1
        },
        "ProviderInstanceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Kind": {
                "const": "provider_instance"
              }
            }
          },
          "then": {
            "required": [
              "ProviderInstanceId"
            ]
          }
        }
      ]
    },
    "ConfigurationSchema": {
      "type": "object",
      "required": [
        "Id",
        "Version"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "WrittenByComponentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "Values": {
      "type": "object"
    },
    "Policies": {
      "type": "object"
    },
    "Metadata": {
      "type": "object"
    }
  },
  "x-aac-schema-id": "_AAC.schema.configuration-persisted-payload",
  "x-aac-schema-version": 1
}
