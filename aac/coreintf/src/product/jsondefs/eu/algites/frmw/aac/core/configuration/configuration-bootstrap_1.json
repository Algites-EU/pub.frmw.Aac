{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Configuration Bootstrap 1",
  "type": "object",
  "required": [
    "ConfigurationBootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "ConfigurationBootstrap": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "DefaultConfigurationProfile",
        "ConfigurationProfiles"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": {
          "const": 1
        },
        "DefaultConfigurationProfile": {
          "type": "string",
          "minLength": 1
        },
        "WorkspaceConfigurationProfiles": {
          "enum": [
            "forbidden",
            "allowed",
            "allowed_if_signed"
          ]
        },
        "MandatoryConfigurationScopeDefinitionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ConfigurationProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Version",
              "ConfigurationScopes"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Version": {
                "type": "integer",
                "minimum": 1
              },
              "ConfigurationScopes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Type",
                    "Resolver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Resolver": {
                      "type": "string",
                      "minLength": 1
                    },
                    "PolicyAuthority": {
                      "type": "boolean"
                    },
                    "Mandatory": {
                      "type": "boolean"
                    },
                    "ConfigurationProviders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "Id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "Id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "Priority": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText"
                    }
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "ConfigurationProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Settings": {
                "type": "object"
              },
              "AuthenticationProfileId": {
                "type": "string",
                "minLength": 1
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "ConfigurationScopeResolvers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Settings": {
                "type": "object"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "Metadata": {
          "type": "object"
        },
        "ConfigurationProfileSources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Uri"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Uri": {
                "type": "string",
                "minLength": 1
              },
              "AuthenticationProfileId": {
                "type": "string",
                "minLength": 1
              },
              "Required": {
                "type": "boolean"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.configuration-bootstrap",
  "x-aac-schema-version": 1
}
