{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "Catalog"
  ],
  "additionalProperties": false,
  "properties": {
    "Catalog": {
      "type": "object",
      "required": [
        "FormatVersion",
        "ProductId",
        "TechnologyId",
        "Components"
      ],
      "additionalProperties": false,
      "properties": {
        "FormatVersion": {
          "const": 1
        },
        "ProductId": {
          "type": "string",
          "minLength": 1
        },
        "TechnologyId": {
          "type": "string",
          "minLength": 1
        },
        "GeneratedAt": {
          "type": "string",
          "minLength": 1
        },
        "Metadata": {
          "type": "object"
        },
        "Components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "permission": {
      "type": "object",
      "required": [
        "Id"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "Metadata": {
          "type": "object"
        },
        "PossibleLicensingScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilityEntitlement": {
      "type": "object",
      "required": [
        "Capability",
        "Permissions"
      ],
      "additionalProperties": false,
      "properties": {
        "Capability": {
          "type": "object",
          "required": [
            "Id",
            "Version"
          ],
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            },
            "Version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "Permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "Id",
        "Locator",
        "ArtifactFilename",
        "PackageFormat",
        "DescriptorPath",
        "Sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Locator": {
          "type": "object",
          "required": [
            "Type"
          ],
          "additionalProperties": false,
          "properties": {
            "Type": {
              "enum": [
                "uri",
                "repository"
              ]
            },
            "Uri": {
              "type": "string",
              "minLength": 1
            },
            "RepositoryId": {
              "type": "string",
              "minLength": 1
            },
            "Coordinates": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "Type": {
                    "const": "uri"
                  }
                }
              },
              "then": {
                "required": [
                  "Uri"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "Type": {
                    "const": "repository"
                  }
                }
              },
              "then": {
                "required": [
                  "RepositoryId"
                ]
              }
            }
          ]
        },
        "ArtifactFilename": {
          "type": "string",
          "minLength": 1
        },
        "PackageFormat": {
          "type": "string",
          "minLength": 1
        },
        "DescriptorPath": {
          "type": "string",
          "minLength": 1
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "RuntimePackage": {
          "type": "string",
          "minLength": 1
        },
        "VerifierId": {
          "type": "string",
          "minLength": 1
        },
        "Platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Metadata": {
          "type": "object"
        },
        "AuthenticationProfileId": {
          "type": "string",
          "minLength": 1
        },
        "Sidecars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Uri",
              "Suffix"
            ],
            "additionalProperties": false,
            "properties": {
              "Uri": {
                "type": "string",
                "minLength": 1
              },
              "Suffix": {
                "type": "string",
                "pattern": "^\\..+"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "Version",
        "Artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "Version": {
          "type": "integer",
          "minimum": 1
        },
        "PublishedAt": {
          "type": "string",
          "minLength": 1
        },
        "ReleaseNotesUrl": {
          "type": "string",
          "minLength": 1
        },
        "Provides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Capability",
              "Versions"
            ],
            "additionalProperties": false,
            "properties": {
              "Capability": {
                "type": "string",
                "minLength": 1
              },
              "Versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "Requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Capability"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Capability": {
                "type": "string",
                "minLength": 1
              },
              "Versions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "Cardinality": {
                "enum": [
                  "single",
                  "multiple"
                ]
              },
              "Mandatory": {
                "type": "boolean"
              }
            }
          }
        },
        "Artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "Metadata": {
          "type": "object"
        },
        "PersistentSchemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persistentSchema"
          }
        },
        "EntitlementLicensingScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              },
              "Metadata": {
                "type": "object"
              }
            }
          }
        },
        "ProvidedCapabilityEntitlements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityEntitlement"
          }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "ComponentId",
        "Releases"
      ],
      "additionalProperties": false,
      "properties": {
        "ComponentId": {
          "type": "string",
          "minLength": 1
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "Publisher": {
          "type": "object",
          "required": [
            "Id"
          ],
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            },
            "Name": {
              "$ref": "#/$defs/displayText"
            }
          }
        },
        "HomepageUrl": {
          "type": "string",
          "minLength": 1
        },
        "DocumentationUrl": {
          "type": "string",
          "minLength": 1
        },
        "SupportUrl": {
          "type": "string",
          "minLength": 1
        },
        "EntitlementInfoUrl": {
          "type": "string",
          "minLength": 1
        },
        "Icon": {
          "type": "object",
          "required": [
            "Url"
          ],
          "additionalProperties": false,
          "properties": {
            "Url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "Categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Releases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release"
          }
        },
        "Metadata": {
          "type": "object"
        }
      }
    },
    "persistentSchema": {
      "type": "object",
      "required": [
        "Kind",
        "SchemaId"
      ],
      "additionalProperties": false,
      "properties": {
        "Kind": {
          "enum": [
            "component_configuration",
            "provider_configuration",
            "data_entity"
          ]
        },
        "SchemaId": {
          "type": "string",
          "minLength": 1
        },
        "WriteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "ProviderId": {
          "type": "string",
          "minLength": 1
        },
        "ReadableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "WritableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "PreferredWriteVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Kind": {
                "const": "component_configuration"
              }
            }
          },
          "then": {
            "required": [
              "WriteVersion"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ProviderId"
                  ]
                },
                {
                  "required": [
                    "ReadableVersions"
                  ]
                },
                {
                  "required": [
                    "WritableVersions"
                  ]
                },
                {
                  "required": [
                    "PreferredWriteVersion"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "Kind": {
                "const": "provider_configuration"
              }
            }
          },
          "then": {
            "required": [
              "ProviderId",
              "WriteVersion"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ReadableVersions"
                  ]
                },
                {
                  "required": [
                    "WritableVersions"
                  ]
                },
                {
                  "required": [
                    "PreferredWriteVersion"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "Kind": {
                "const": "data_entity"
              }
            }
          },
          "then": {
            "required": [
              "ReadableVersions",
              "WritableVersions"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "ProviderId"
                  ]
                },
                {
                  "required": [
                    "WriteVersion"
                  ]
                }
              ]
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "ReadableVersions": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "WritableVersions": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              },
              {
                "if": {
                  "properties": {
                    "WritableVersions": {
                      "minItems": 1
                    }
                  },
                  "required": [
                    "WritableVersions"
                  ]
                },
                "then": {
                  "required": [
                    "PreferredWriteVersion"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "PreferredWriteVersion"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "title": "AAC Component Catalog 1",
  "x-aac-schema-id": "_AAC.schema.catalog",
  "x-aac-schema-version": 1
}
