{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Component Descriptor 1",
  "$defs": {
    "persistedSchema": {
      "type": "object",
      "required": [
        "Id",
        "WriteVersion",
        "ReadableVersions",
        "Resource"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "WriteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "ReadableVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "Resource": {
          "type": "string",
          "minLength": 1
        },
        "Migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaMigrationStep"
          }
        }
      }
    },
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    },
    "schemaMigrationStep": {
      "type": "object",
      "required": [
        "From",
        "To",
        "Migrator"
      ],
      "additionalProperties": false,
      "properties": {
        "From": {
          "type": "integer",
          "minimum": 1
        },
        "To": {
          "type": "integer",
          "minimum": 1
        },
        "Migrator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataEntityRequirement": {
      "type": "object",
      "required": [
        "SchemaId",
        "Access"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaId": {
          "type": "string",
          "minLength": 1
        },
        "Access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "ReadableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "WritableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "Required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Access": {
                "contains": {
                  "const": "read"
                }
              }
            },
            "required": [
              "Access"
            ]
          },
          "then": {
            "required": [
              "ReadableVersions"
            ],
            "properties": {
              "ReadableVersions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "Access": {
                "contains": {
                  "const": "write"
                }
              }
            },
            "required": [
              "Access"
            ]
          },
          "then": {
            "required": [
              "WritableVersions"
            ],
            "properties": {
              "WritableVersions": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "dataEntitySupport": {
      "type": "object",
      "required": [
        "SchemaId",
        "ReadableVersions",
        "WritableVersions"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaId": {
          "type": "string",
          "minLength": 1
        },
        "ReadableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "WritableVersions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "PreferredWriteVersion": {
          "type": "integer",
          "minimum": 1
        },
        "Migrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/schemaMigrationStep"
          }
        },
        "DataEntityRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataEntityRequirement"
          }
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "Metadata": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "WritableVersions": {
                "minItems": 1
              }
            },
            "required": [
              "WritableVersions"
            ]
          },
          "then": {
            "required": [
              "PreferredWriteVersion"
            ]
          },
          "else": {
            "not": {
              "required": [
                "PreferredWriteVersion"
              ]
            }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "ReadableVersions": {
                  "minItems": 1
                }
              }
            },
            {
              "properties": {
                "WritableVersions": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "Component"
  ],
  "additionalProperties": false,
  "properties": {
    "Component": {
      "type": "object",
      "required": [
        "Id",
        "Version"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "minimum": 1
        },
        "CapabilityGroups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Capability": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ComponentConfigurationSchema": {
          "$ref": "#/$defs/persistedSchema"
        },
        "CapabilityProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Capabilities",
              "ImplementationClasses"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Versions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Versions": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              },
              "ConfigurationSchema": {
                "$ref": "#/$defs/persistedSchema"
              },
              "InitialInstances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "Name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Configuration": {
                      "type": "object"
                    },
                    "AccessMode": {
                      "enum": [
                        "read_only",
                        "read_write"
                      ],
                      "default": "read_write"
                    }
                  }
                }
              },
              "RuntimeFactoryClass": {
                "type": "string",
                "minLength": 1
              },
              "Requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Capability"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Capability": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Versions": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "Cardinality": {
                      "enum": [
                        "single",
                        "multiple"
                      ]
                    },
                    "Mandatory": {
                      "type": "boolean"
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText"
                    },
                    "RequestedAuthorizations": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "Runtime": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "Profile": {
                    "enum": [
                      "in_process",
                      "process",
                      "subinterpreter"
                    ]
                  },
                  "Command": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "Cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "Environment": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "TimeoutSeconds": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              },
              "ReadinessRequirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Source",
                    "Key"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Source": {
                      "enum": [
                        "component_configuration",
                        "provider_configuration",
                        "context"
                      ]
                    },
                    "Key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "MissingState": {
                      "enum": [
                        "degraded",
                        "not_ready"
                      ]
                    },
                    "Message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "Operations": {
                "type": "array",
                "description": "Provider-specific metadata for concrete capability operations implemented by this provider definition.",
                "items": {
                  "type": "object",
                  "required": [
                    "Capability",
                    "CapabilityVersion",
                    "Operation",
                    "Interaction"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Capability": {
                      "type": "string",
                      "minLength": 1
                    },
                    "CapabilityVersion": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "Operation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Interaction": {
                      "type": "object",
                      "required": [
                        "SupportedStateResultDeliveryModes"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "SupportedStateResultDeliveryModes": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "contains": {
                            "const": "on_demand_complete"
                          },
                          "items": {
                            "enum": [
                              "on_demand_complete",
                              "on_demand_delta",
                              "on_change_complete",
                              "on_change_delta",
                              "always_complete"
                            ]
                          }
                        },
                        "ProgressReporting": {
                          "type": "boolean",
                          "default": false
                        },
                        "Cancellation": {
                          "type": "boolean",
                          "default": false
                        },
                        "DetailLevel": {
                          "type": "boolean",
                          "default": false
                        },
                        "ReportingInterval": {
                          "type": "boolean",
                          "default": false
                        }
                      }
                    },
                    "Parameters": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "Id",
                          "Name",
                          "Description",
                          "ValueSchema"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "Id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "Name": {
                            "$ref": "#/$defs/displayText"
                          },
                          "Description": {
                            "$ref": "#/$defs/displayText"
                          },
                          "ValueSchema": {
                            "type": "object"
                          },
                          "EnumValues": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "required": [
                                "Value",
                                "Name"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "Value": {},
                                "Name": {
                                  "$ref": "#/$defs/displayText"
                                },
                                "Description": {
                                  "$ref": "#/$defs/displayText"
                                }
                              }
                            }
                          },
                          "Required": {
                            "type": "boolean",
                            "default": false
                          },
                          "Default": {},
                          "ComponentConfigurable": {
                            "type": "boolean",
                            "default": false
                          },
                          "InstanceConfigurable": {
                            "type": "boolean",
                            "default": false
                          },
                          "InvocationOverridable": {
                            "type": "boolean",
                            "default": false
                          }
                        }
                      }
                    }
                  }
                }
              },
              "ImplementationClasses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "TechnologyKind",
                    "ClassName"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "TechnologyKind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ClassName": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "description": "Component-declared capability provider definitions. Each definition binds one implementation role to the capability contract versions it provides; configured provider instances are created from these definitions."
        },
        "Lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Provision": {
              "type": "string"
            },
            "Validate": {
              "type": "string"
            },
            "Unprovision": {
              "type": "string"
            }
          }
        },
        "Metadata": {
          "type": "object"
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "EntitlementLicensingScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              },
              "Metadata": {
                "type": "object"
              }
            }
          }
        },
        "ProvidedCapabilityEntitlements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Capability",
              "Permissions"
            ],
            "additionalProperties": false,
            "properties": {
              "Capability": {
                "type": "object",
                "required": [
                  "Id",
                  "Version"
                ],
                "additionalProperties": false,
                "properties": {
                  "Id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "Version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "Permissions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText"
                    },
                    "Metadata": {
                      "type": "object"
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "PossibleLicensingScopes": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "DataEntitySupport": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataEntitySupport"
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.component-descriptor",
  "x-aac-schema-version": 1
}
