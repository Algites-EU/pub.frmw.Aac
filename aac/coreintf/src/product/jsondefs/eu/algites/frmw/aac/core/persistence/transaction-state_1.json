{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.persistence-transaction-state/1",
  "title": "AAC Persistence Transaction State 1",
  "type": "object",
  "required": [
    "FormatVersion",
    "TransactionId",
    "Phase",
    "UpdatedAt",
    "Diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "FormatVersion": {
      "const": 1
    },
    "TransactionId": {
      "type": "string",
      "minLength": 1
    },
    "Phase": {
      "enum": [
        "prepared",
        "commit_started",
        "committed",
        "cleanup_completed",
        "aborted"
      ]
    },
    "UpdatedAt": {
      "type": "string"
    },
    "Diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.persistence-transaction-state",
  "x-aac-schema-version": 1
}
