{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Provider Instance 1",
  "type": "object",
  "required": [
    "Id",
    "ComponentId",
    "ProviderDefinitionId",
    "Name",
    "Capabilities",
    "AccessMode",
    "ImplementationClass"
  ],
  "properties": {
    "Id": {
      "type": "string",
      "minLength": 1
    },
    "ComponentId": {
      "type": "string",
      "minLength": 1
    },
    "ProviderDefinitionId": {
      "type": "string",
      "minLength": 1
    },
    "Name": {
      "type": "string",
      "minLength": 1
    },
    "ImplementationClass": {
      "type": "string",
      "minLength": 1
    },
    "ConfigurationSchema": {
      "type": [
        "string",
        "null"
      ]
    },
    "Configuration": {
      "type": "object"
    },
    "State": {
      "type": "string"
    },
    "Capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id",
          "Versions"
        ],
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1
          },
          "Versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "AccessMode": {
      "enum": [
        "read_only",
        "read_write"
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.provider-instance",
  "x-aac-schema-version": 1
}
