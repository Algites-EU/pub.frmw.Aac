{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.active-package-set/1",
  "title": "AAC Active Package Set 1",
  "type": "object",
  "required": [
    "FormatVersion",
    "RecordRevision",
    "Selections"
  ],
  "additionalProperties": false,
  "properties": {
    "FormatVersion": {
      "const": 1
    },
    "RecordRevision": {
      "type": "integer",
      "minimum": 0
    },
    "LastTransactionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "Selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ApplicationScopeId",
          "ComponentId",
          "ComponentVersion",
          "Sha256",
          "SelectedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "ApplicationScopeId": {
            "type": "string",
            "minLength": 1
          },
          "ComponentId": {
            "type": "string",
            "minLength": 1
          },
          "ComponentVersion": {
            "type": "integer",
            "minimum": 1
          },
          "Sha256": {
            "type": "string",
            "minLength": 1
          },
          "SelectedAt": {
            "type": "string"
          },
          "PreviousSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "PreviousVersion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.active-package-set",
  "x-aac-schema-version": 1
}
