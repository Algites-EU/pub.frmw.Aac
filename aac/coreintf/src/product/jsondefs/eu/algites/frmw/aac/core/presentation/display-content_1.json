{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.display-content",
  "x-aac-schema-version": 1,
  "title": "Display Content 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Content": {
      "type": "string",
      "minLength": 1
    },
    "ResourceKey": {
      "type": "string",
      "minLength": 1
    },
    "Format": {
      "enum": [
        "plain_text",
        "markdown",
        "html"
      ],
      "default": "plain_text"
    }
  },
  "anyOf": [
    {
      "required": [
        "Content"
      ]
    },
    {
      "required": [
        "ResourceKey"
      ]
    }
  ]
}
