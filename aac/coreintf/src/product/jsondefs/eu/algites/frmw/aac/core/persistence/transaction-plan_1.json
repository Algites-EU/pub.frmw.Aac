{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.persistence-transaction-plan/1",
  "title": "AAC Persistence Transaction Plan 1",
  "type": "object",
  "required": [
    "FormatVersion",
    "TransactionId",
    "TransactionType",
    "CreatedAt",
    "ReadSet",
    "WriteSet",
    "Metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "FormatVersion": {
      "const": 1
    },
    "TransactionId": {
      "type": "string",
      "minLength": 1
    },
    "TransactionType": {
      "type": "string",
      "minLength": 1
    },
    "CreatedAt": {
      "type": "string"
    },
    "ReadSet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "RecordId",
          "ExpectAbsent"
        ],
        "additionalProperties": false,
        "properties": {
          "RecordId": {
            "type": "string",
            "minLength": 1
          },
          "ExpectedRecordRevision": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "ExpectAbsent": {
            "type": "boolean"
          }
        }
      }
    },
    "WriteSet": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "RecordId",
          "Operation",
          "Metadata"
        ],
        "additionalProperties": false,
        "properties": {
          "RecordId": {
            "type": "string",
            "minLength": 1
          },
          "Operation": {
            "type": "string",
            "minLength": 1
          },
          "TargetRecordRevision": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "Metadata": {
            "type": "object"
          }
        }
      }
    },
    "Metadata": {
      "type": "object"
    }
  },
  "x-aac-schema-id": "_AAC.schema.persistence-transaction-plan",
  "x-aac-schema-version": 1
}
