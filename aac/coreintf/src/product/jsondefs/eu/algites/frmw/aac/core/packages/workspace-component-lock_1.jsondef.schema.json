{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.workspace-component-lock/1",
  "type": "object",
  "required": [
    "WorkspaceComponentLock"
  ],
  "additionalProperties": false,
  "properties": {
    "WorkspaceComponentLock": {
      "type": "object",
      "required": [
        "WorkspaceId",
        "Entries"
      ],
      "additionalProperties": false,
      "properties": {
        "WorkspaceId": {
          "type": "string",
          "minLength": 1
        },
        "Entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ComponentId",
              "ComponentVersion",
              "Sha256",
              "SourceId",
              "ArtifactUri",
              "ArtifactFilename",
              "PackageFormat",
              "DescriptorPath"
            ],
            "additionalProperties": false,
            "properties": {
              "ComponentId": {
                "type": "string",
                "minLength": 1
              },
              "ComponentVersion": {
                "type": "integer",
                "minimum": 1
              },
              "Sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "SourceId": {
                "type": "string",
                "minLength": 1
              },
              "ArtifactUri": {
                "type": "string",
                "minLength": 1
              },
              "ArtifactFilename": {
                "type": "string",
                "minLength": 1
              },
              "PackageFormat": {
                "type": "string",
                "minLength": 1
              },
              "DescriptorPath": {
                "type": "string",
                "minLength": 1
              },
              "RuntimePackage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "VerifierId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Sidecars": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Uri",
                    "Suffix"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Uri": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Suffix": {
                      "type": "string",
                      "pattern": "^\\..+"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.workspace-component-lock",
  "x-aac-schema-version": 1
}
