{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-query-records-running-complete-result",
  "x-aac-schema-version": 1,
  "title": "Data Entity Query Records Running Complete Result 1",
  "type": "object",
  "required": [
    "Records",
    "ContinuationToken"
  ],
  "additionalProperties": false,
  "properties": {
    "Records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Uid",
          "SchemaId",
          "SchemaVersion",
          "RecordRevision",
          "State",
          "Payload"
        ],
        "additionalProperties": false,
        "properties": {
          "Uid": {
            "type": "string",
            "minLength": 1
          },
          "SchemaId": {
            "type": "string",
            "minLength": 1
          },
          "SchemaVersion": {
            "type": "integer",
            "minimum": 1
          },
          "RecordRevision": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "State": {
            "enum": [
              "active",
              "tombstone"
            ]
          },
          "Payload": {
            "type": "object"
          }
        }
      }
    },
    "ContinuationToken": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$comment": "Complete RUNNING snapshot for query-records. records contains all records published so far for this invocation."
}
