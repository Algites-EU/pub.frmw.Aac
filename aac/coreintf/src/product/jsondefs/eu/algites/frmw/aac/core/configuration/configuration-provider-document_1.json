{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Configuration Provider Document 1",
  "type": "object",
  "required": [
    "FormatVersion",
    "ConfigurationScope",
    "ConfigurationTarget",
    "RecordRevision",
    "Payload"
  ],
  "additionalProperties": false,
  "properties": {
    "FormatVersion": {
      "const": 1
    },
    "ConfigurationScope": {
      "type": "object",
      "required": [
        "Type"
      ],
      "additionalProperties": false,
      "properties": {
        "Type": {
          "type": "string",
          "minLength": 1
        },
        "Id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ConfigurationTarget": {
      "type": "object",
      "required": [
        "Kind",
        "ComponentId"
      ],
      "additionalProperties": false,
      "properties": {
        "Kind": {
          "enum": [
            "component",
            "provider_instance"
          ]
        },
        "ComponentId": {
          "type": "string",
          "minLength": 1
        },
        "ProviderInstanceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Payload": {
      "type": "object",
      "required": [
        "ConfigurationSchemaId",
        "ConfigurationSchemaVersion",
        "WrittenByComponentVersion",
        "Values",
        "Policies"
      ],
      "additionalProperties": false,
      "properties": {
        "ConfigurationSchemaId": {
          "type": "string",
          "minLength": 1
        },
        "ConfigurationSchemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "WrittenByComponentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "Values": {
          "type": "object"
        },
        "Policies": {
          "type": "object"
        },
        "Metadata": {
          "type": "object"
        }
      }
    },
    "RecordRevision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "x-aac-schema-id": "_AAC.schema.configuration-provider-document",
  "x-aac-schema-version": 1
}
