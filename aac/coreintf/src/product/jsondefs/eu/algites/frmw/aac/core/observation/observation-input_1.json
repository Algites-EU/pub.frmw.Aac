{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Observation Input 1",
  "type": "object",
  "required": [
    "InvocationId",
    "Phase",
    "CapabilityId",
    "CapabilityVersion",
    "OperationId",
    "ProviderInstanceId"
  ],
  "properties": {
    "InvocationId": {
      "type": "string"
    },
    "ParentInvocationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "Phase": {
      "enum": [
        "pre",
        "post"
      ]
    },
    "CapabilityId": {
      "type": "string"
    },
    "CapabilityVersion": {
      "type": "integer",
      "minimum": 1
    },
    "OperationId": {
      "type": "string"
    },
    "ProviderInstanceId": {
      "type": "string"
    },
    "Arguments": {
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "success",
        "error",
        null
      ]
    },
    "Result": {},
    "Error": {
      "type": [
        "object",
        "null"
      ]
    },
    "Metadata": {
      "type": "object"
    }
  },
  "x-aac-schema-id": "_AAC.schema.observation-input",
  "x-aac-schema-version": 1
}
