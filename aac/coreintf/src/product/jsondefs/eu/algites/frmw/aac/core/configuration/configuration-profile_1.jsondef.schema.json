{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Configuration Profile 1",
  "type": "object",
  "required": [
    "ConfigurationProfile"
  ],
  "additionalProperties": false,
  "properties": {
    "ConfigurationProfile": {
      "type": "object",
      "required": [
        "Id",
        "Version",
        "ConfigurationScopes"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "minimum": 1
        },
        "ConfigurationScopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type",
              "Resolver"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Resolver": {
                "type": "string",
                "minLength": 1
              },
              "PolicyAuthority": {
                "type": "boolean"
              },
              "Mandatory": {
                "type": "boolean"
              },
              "ConfigurationProviders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Priority": {
                      "type": "integer"
                    }
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.configuration-profile",
  "x-aac-schema-version": 1
}
