{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Capability Group 1",
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "Group"
  ],
  "additionalProperties": false,
  "properties": {
    "Group": {
      "type": "object",
      "required": [
        "Id",
        "Name"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "ParentGroupId": {
          "type": "string",
          "minLength": 1
        },
        "Name": {
          "$ref": "#/$defs/displayText"
        },
        "Description": {
          "$ref": "#/$defs/displayText"
        },
        "Metadata": {
          "type": "object"
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.capability-group",
  "x-aac-schema-version": 1
}
