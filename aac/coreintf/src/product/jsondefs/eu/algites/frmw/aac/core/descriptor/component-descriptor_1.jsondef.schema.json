{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Component Descriptor 1",
  "description": "Defines the canonical AAC Component Descriptor schema and its serialized data contract.",
  "$defs": {
    "persistedSchema": {
      "type": "object",
      "required": [
        "Id",
        "WriteVersion",
        "ReadableVersions",
        "Resource"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "description": "Stable identifier of this persisted schema.",
          "minLength": 1
        },
        "WriteVersion": {
          "type": "integer",
          "description": "Version of the write associated with this persisted schema.",
          "minimum": 1
        },
        "ReadableVersions": {
          "type": "array",
          "description": "Lists the readable versions supported or selected by this persisted schema.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "Resource": {
          "type": "string",
          "description": "Specifies the resource for this persisted schema.",
          "minLength": 1
        },
        "Migrations": {
          "type": "array",
          "description": "Lists the migrations associated with this persisted schema.",
          "items": {
            "$ref": "#/$defs/schemaMigrationStep"
          }
        }
      },
      "description": "Defines the reusable persisted schema structure used by this canonical schema."
    },
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "description": "Human-readable display text.",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "description": "Optional localization resource key for the human-readable text.",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ],
      "description": "Defines the reusable display text structure used by this canonical schema."
    },
    "schemaMigrationStep": {
      "type": "object",
      "required": [
        "From",
        "To",
        "Migrator"
      ],
      "additionalProperties": false,
      "properties": {
        "From": {
          "type": "integer",
          "description": "Specifies the from for this schema migration step.",
          "minimum": 1
        },
        "To": {
          "type": "integer",
          "description": "Specifies the to for this schema migration step.",
          "minimum": 1
        },
        "Migrator": {
          "type": "string",
          "description": "Specifies the migrator for this schema migration step.",
          "minLength": 1
        }
      },
      "description": "Defines the reusable schema migration step structure used by this canonical schema."
    },
    "dataEntityRequirement": {
      "type": "object",
      "required": [
        "SchemaId",
        "Access"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaId": {
          "type": "string",
          "description": "Canonical schema identifier.",
          "minLength": 1
        },
        "Access": {
          "type": "array",
          "description": "Lists the access associated with this data entity requirement.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "ReadableVersions": {
          "type": "array",
          "description": "Lists the readable versions supported or selected by this data entity requirement.",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "WritableVersions": {
          "type": "array",
          "description": "Lists the writable versions supported or selected by this data entity requirement.",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "Required": {
          "type": "boolean",
          "description": "Indicates whether required applies to this data entity requirement."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "Access": {
                "contains": {
                  "const": "read"
                },
                "description": "Access mode requested for the Data Entity schema."
              }
            },
            "required": [
              "Access"
            ]
          },
          "then": {
            "required": [
              "ReadableVersions"
            ],
            "properties": {
              "ReadableVersions": {
                "minItems": 1,
                "description": "Schema versions that may be read by this declaration."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "Access": {
                "contains": {
                  "const": "write"
                },
                "description": "Access mode requested for the Data Entity schema."
              }
            },
            "required": [
              "Access"
            ]
          },
          "then": {
            "required": [
              "WritableVersions"
            ],
            "properties": {
              "WritableVersions": {
                "minItems": 1,
                "description": "Schema versions that may be written by this declaration."
              }
            }
          }
        }
      ],
      "description": "Defines the reusable data entity requirement structure used by this canonical schema."
    },
    "dataEntitySupport": {
      "type": "object",
      "required": [
        "SchemaId",
        "ReadableVersions",
        "WritableVersions"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaId": {
          "type": "string",
          "description": "Canonical schema identifier.",
          "minLength": 1
        },
        "ReadableVersions": {
          "type": "array",
          "description": "Lists the readable versions supported or selected by this data entity support.",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "WritableVersions": {
          "type": "array",
          "description": "Lists the writable versions supported or selected by this data entity support.",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "PreferredWriteVersion": {
          "type": "integer",
          "description": "Version of the preferred write associated with this data entity support.",
          "minimum": 1
        },
        "Migrations": {
          "type": "array",
          "description": "Lists the migrations associated with this data entity support.",
          "items": {
            "$ref": "#/$defs/schemaMigrationStep"
          }
        },
        "DataEntityRequirements": {
          "type": "array",
          "description": "Lists the data entity requirements associated with this data entity support.",
          "items": {
            "$ref": "#/$defs/dataEntityRequirement"
          }
        },
        "Name": {
          "$ref": "#/$defs/displayText",
          "description": "Human-readable name of this data entity support."
        },
        "Description": {
          "$ref": "#/$defs/displayText",
          "description": "Human-readable description of this data entity support."
        },
        "Metadata": {
          "type": "object",
          "description": "Additional structured metadata associated with this data entity support."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "WritableVersions": {
                "minItems": 1,
                "description": "Schema versions that may be written by this declaration."
              }
            },
            "required": [
              "WritableVersions"
            ]
          },
          "then": {
            "required": [
              "PreferredWriteVersion"
            ]
          },
          "else": {
            "not": {
              "required": [
                "PreferredWriteVersion"
              ]
            }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "ReadableVersions": {
                  "minItems": 1,
                  "description": "Lists the readable versions supported or selected by this data entity support."
                }
              }
            },
            {
              "properties": {
                "WritableVersions": {
                  "minItems": 1,
                  "description": "Lists the writable versions supported or selected by this data entity support."
                }
              }
            }
          ]
        }
      ],
      "description": "Defines the reusable data entity support structure used by this canonical schema."
    }
  },
  "type": "object",
  "required": [
    "Component"
  ],
  "additionalProperties": false,
  "properties": {
    "Component": {
      "type": "object",
      "description": "Structured component associated with this AAC component descriptor.",
      "required": [
        "Id",
        "Version"
      ],
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "description": "Stable identifier of this component.",
          "minLength": 1
        },
        "Version": {
          "type": "integer",
          "description": "Version of this component.",
          "minimum": 1
        },
        "CapabilityGroups": {
          "type": "array",
          "description": "Lists the capability groups associated with this component.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "Capability": {
          "type": "array",
          "description": "Identity and human-facing metadata of the capability contract.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ComponentConfigurationSchema": {
          "$ref": "#/$defs/persistedSchema",
          "description": "Specifies the component configuration schema for this component."
        },
        "CapabilityProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Capabilities",
              "ImplementationClasses"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "description": "Stable identifier of this capability provider.",
                "minLength": 1
              },
              "Capabilities": {
                "type": "array",
                "description": "Lists the capabilities associated with this capability provider.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Versions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "description": "Stable identifier of this capability.",
                      "minLength": 1
                    },
                    "Versions": {
                      "type": "array",
                      "description": "Lists the versions supported or selected by this capability.",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "BindingQualifierProfiles": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Concrete binding-qualifier profiles offered by this provider capability declaration. Each profile MUST validate against BindingQualifiersSchema of the resolved Capability Contract version. If that contract version has no BindingQualifiersSchema, BindingQualifierProfiles MUST NOT be declared.",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              },
              "ConfigurationSchema": {
                "$ref": "#/$defs/persistedSchema",
                "description": "Canonical schema reference used to validate this configuration."
              },
              "InitialInstances": {
                "type": "array",
                "description": "Lists the initial instances associated with this capability provider.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "Name": {
                      "type": "string",
                      "description": "Human-readable name of this initial instance.",
                      "minLength": 1
                    },
                    "Configuration": {
                      "type": "object",
                      "description": "Configuration values supplied to this initial instance."
                    },
                    "AccessMode": {
                      "enum": [
                        "read_only",
                        "read_write"
                      ],
                      "description": "Declares the permitted read/write access mode for this provider instance or resource.",
                      "default": "read_write"
                    }
                  }
                }
              },
              "RuntimeFactoryClass": {
                "type": "string",
                "description": "Implementation class responsible for constructing the runtime provider object.",
                "minLength": 1
              },
              "Requirements": {
                "type": "array",
                "description": "Indicates whether requirements applies to this capability provider.",
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Capability"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "description": "Stable identifier of this requirement.",
                      "minLength": 1
                    },
                    "Capability": {
                      "type": "string",
                      "description": "Identity and human-facing metadata of the capability contract.",
                      "minLength": 1
                    },
                    "Versions": {
                      "type": "array",
                      "description": "Lists the versions supported or selected by this requirement.",
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "Cardinality": {
                      "enum": [
                        "single",
                        "multiple"
                      ],
                      "description": "Specifies the cardinality for this requirement."
                    },
                    "Mandatory": {
                      "type": "boolean",
                      "description": "Indicates whether mandatory applies to this requirement."
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText",
                      "description": "Human-readable name of this requirement."
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText",
                      "description": "Human-readable description of this requirement."
                    },
                    "RequestedAuthorizations": {
                      "type": "array",
                      "description": "Lists the requested authorizations associated with this requirement.",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "Runtime": {
                "type": "object",
                "description": "Structured runtime associated with this capability provider.",
                "additionalProperties": false,
                "properties": {
                  "Profile": {
                    "enum": [
                      "in_process",
                      "process",
                      "subinterpreter"
                    ],
                    "description": "Specifies the profile for this runtime."
                  },
                  "Command": {
                    "type": "array",
                    "description": "Lists the command associated with this runtime.",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "Cwd": {
                    "type": "string",
                    "description": "Specifies the cwd for this runtime.",
                    "minLength": 1
                  },
                  "Environment": {
                    "type": "object",
                    "description": "Structured environment associated with this runtime.",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "TimeoutSeconds": {
                    "type": "number",
                    "description": "Specifies the timeout seconds for this runtime.",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText",
                "description": "Human-readable name of this capability provider."
              },
              "Description": {
                "$ref": "#/$defs/displayText",
                "description": "Human-readable description of this capability provider."
              },
              "ReadinessRequirements": {
                "type": "array",
                "description": "Lists the readiness requirements associated with this capability provider.",
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Source",
                    "Key"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "description": "Stable identifier of this readiness requirement.",
                      "minLength": 1
                    },
                    "Source": {
                      "enum": [
                        "component_configuration",
                        "provider_configuration",
                        "context"
                      ],
                      "description": "Specifies the source for this readiness requirement."
                    },
                    "Key": {
                      "type": "string",
                      "description": "Specifies the key for this readiness requirement.",
                      "minLength": 1
                    },
                    "MissingState": {
                      "enum": [
                        "degraded",
                        "not_ready"
                      ],
                      "description": "Specifies the missing state for this readiness requirement."
                    },
                    "Message": {
                      "type": "string",
                      "description": "Specifies the message for this readiness requirement.",
                      "minLength": 1
                    }
                  }
                }
              },
              "Operations": {
                "type": "array",
                "description": "Provider-specific metadata for concrete capability operations implemented by this provider definition.",
                "items": {
                  "type": "object",
                  "required": [
                    "Capability",
                    "CapabilityVersion",
                    "Operation",
                    "Interaction"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Capability": {
                      "type": "string",
                      "description": "Identity and human-facing metadata of the capability contract.",
                      "minLength": 1
                    },
                    "CapabilityVersion": {
                      "type": "integer",
                      "description": "Canonical capability-contract version.",
                      "minimum": 1
                    },
                    "Operation": {
                      "type": "string",
                      "description": "Specifies the operation for this operation.",
                      "minLength": 1
                    },
                    "Interaction": {
                      "type": "object",
                      "description": "Structured interaction associated with this operation.",
                      "required": [
                        "SupportedStateResultDeliveryModes"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "SupportedStateResultDeliveryModes": {
                          "type": "array",
                          "description": "Lists the supported state result delivery modes associated with this interaction.",
                          "minItems": 1,
                          "uniqueItems": true,
                          "contains": {
                            "const": "on_demand_complete"
                          },
                          "items": {
                            "enum": [
                              "on_demand_complete",
                              "on_demand_delta",
                              "on_change_complete",
                              "on_change_delta",
                              "always_complete"
                            ]
                          }
                        },
                        "ProgressReporting": {
                          "type": "boolean",
                          "description": "Indicates whether progress reporting applies to this interaction.",
                          "default": false
                        },
                        "Cancellation": {
                          "type": "boolean",
                          "description": "Indicates whether cancellation applies to this interaction.",
                          "default": false
                        },
                        "DetailLevel": {
                          "type": "boolean",
                          "description": "Indicates whether detail level applies to this interaction.",
                          "default": false
                        },
                        "ReportingInterval": {
                          "type": "boolean",
                          "description": "Indicates whether reporting interval applies to this interaction.",
                          "default": false
                        }
                      }
                    },
                    "Parameters": {
                      "type": "array",
                      "description": "Lists the parameters associated with this operation.",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "Id",
                          "Name",
                          "Description",
                          "ValueSchema"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "Id": {
                            "type": "string",
                            "description": "Stable identifier of this parameter.",
                            "minLength": 1
                          },
                          "Name": {
                            "$ref": "#/$defs/displayText",
                            "description": "Human-readable name of this parameter."
                          },
                          "Description": {
                            "$ref": "#/$defs/displayText",
                            "description": "Human-readable description of this parameter."
                          },
                          "ValueSchema": {
                            "type": "object",
                            "description": "Structured value schema associated with this parameter."
                          },
                          "EnumValues": {
                            "type": "array",
                            "description": "Lists the enum values associated with this parameter.",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "required": [
                                "Value",
                                "Name"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "Value": {
                                  "description": "Specifies the value for this enum value."
                                },
                                "Name": {
                                  "$ref": "#/$defs/displayText",
                                  "description": "Human-readable name of this enum value."
                                },
                                "Description": {
                                  "$ref": "#/$defs/displayText",
                                  "description": "Human-readable description of this enum value."
                                }
                              }
                            }
                          },
                          "Required": {
                            "type": "boolean",
                            "description": "Indicates whether required applies to this parameter.",
                            "default": false
                          },
                          "Default": {
                            "description": "Specifies the default for this parameter."
                          },
                          "ComponentConfigurable": {
                            "type": "boolean",
                            "description": "Indicates whether component configurable applies to this parameter.",
                            "default": false
                          },
                          "InstanceConfigurable": {
                            "type": "boolean",
                            "description": "Indicates whether instance configurable applies to this parameter.",
                            "default": false
                          },
                          "InvocationOverridable": {
                            "type": "boolean",
                            "description": "Indicates whether invocation overridable applies to this parameter.",
                            "default": false
                          }
                        }
                      }
                    }
                  }
                }
              },
              "ImplementationClasses": {
                "type": "array",
                "description": "Technology-specific implementation classes available for this provider definition.",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "TechnologyKind",
                    "ProviderClassName"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "TechnologyKind": {
                      "type": "string",
                      "description": "Technology kind to which this implementation entry applies.",
                      "minLength": 1
                    },
                    "ProviderClassName": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Technology-specific provider runtime implementation class name."
                    },
                    "CapabilityProfileMatcherClassName": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Optional technology-specific resolution-time matcher class used by this consumer implementation to select zero or more provider BindingQualifierProfiles for qualified capability requirements. The matcher is instantiated independently during RESOLVE and is not a provider runtime instance."
                    }
                  }
                }
              }
            }
          },
          "description": "Component-declared capability provider definitions. Each definition binds one implementation role to the capability contract versions it provides; configured provider instances are created from these definitions."
        },
        "Lifecycle": {
          "type": "object",
          "description": "Structured lifecycle associated with this component.",
          "additionalProperties": false,
          "properties": {
            "Provision": {
              "type": "string",
              "description": "Specifies the provision for this lifecycle."
            },
            "Validate": {
              "type": "string",
              "description": "Specifies the validate for this lifecycle."
            },
            "Unprovision": {
              "type": "string",
              "description": "Specifies the unprovision for this lifecycle."
            }
          }
        },
        "Metadata": {
          "type": "object",
          "description": "Additional structured metadata associated with this component."
        },
        "Name": {
          "$ref": "#/$defs/displayText",
          "description": "Human-readable name of this component."
        },
        "Description": {
          "$ref": "#/$defs/displayText",
          "description": "Human-readable description of this component."
        },
        "EntitlementLicensingScopes": {
          "type": "array",
          "description": "Lists the entitlement licensing scopes associated with this component.",
          "items": {
            "type": "object",
            "required": [
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Type": {
                "type": "string",
                "description": "Type discriminator for this entitlement licensing scope.",
                "minLength": 1
              },
              "Name": {
                "$ref": "#/$defs/displayText",
                "description": "Human-readable name of this entitlement licensing scope."
              },
              "Description": {
                "$ref": "#/$defs/displayText",
                "description": "Human-readable description of this entitlement licensing scope."
              },
              "Metadata": {
                "type": "object",
                "description": "Additional structured metadata associated with this entitlement licensing scope."
              }
            }
          }
        },
        "ProvidedCapabilityEntitlements": {
          "type": "array",
          "description": "Lists the provided capability entitlements associated with this component.",
          "items": {
            "type": "object",
            "required": [
              "Capability",
              "Permissions"
            ],
            "additionalProperties": false,
            "properties": {
              "Capability": {
                "type": "object",
                "description": "Identity and human-facing metadata of the capability contract.",
                "required": [
                  "Id",
                  "Version"
                ],
                "additionalProperties": false,
                "properties": {
                  "Id": {
                    "type": "string",
                    "description": "Stable identifier of this capability.",
                    "minLength": 1
                  },
                  "Version": {
                    "type": "integer",
                    "description": "Version of this capability.",
                    "minimum": 1
                  }
                }
              },
              "Permissions": {
                "type": "array",
                "description": "Authorization or entitlement permissions associated with this provided capability entitlement.",
                "items": {
                  "type": "object",
                  "required": [
                    "Id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "description": "Stable identifier of this permission.",
                      "minLength": 1
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText",
                      "description": "Human-readable description of this permission."
                    },
                    "Metadata": {
                      "type": "object",
                      "description": "Additional structured metadata associated with this permission."
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText",
                      "description": "Human-readable name of this permission."
                    },
                    "PossibleLicensingScopes": {
                      "type": "array",
                      "description": "Lists the possible licensing scopes associated with this permission.",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "Name": {
                "$ref": "#/$defs/displayText",
                "description": "Human-readable name of this provided capability entitlement."
              },
              "Description": {
