{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-get-record-result",
  "x-aac-schema-version": 1,
  "title": "Data Entity Get Record Result 1",
  "type": "object",
  "required": [
    "Record"
  ],
  "additionalProperties": false,
  "properties": {
    "Record": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Uid",
            "SchemaId",
            "SchemaVersion",
            "RecordRevision",
            "State",
            "Payload"
          ],
          "additionalProperties": false,
          "properties": {
            "Uid": {
              "type": "string",
              "minLength": 1
            },
            "SchemaId": {
              "type": "string",
              "minLength": 1
            },
            "SchemaVersion": {
              "type": "integer",
              "minimum": 1
            },
            "RecordRevision": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "State": {
              "enum": [
                "active",
                "tombstone"
              ]
            },
            "Payload": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
