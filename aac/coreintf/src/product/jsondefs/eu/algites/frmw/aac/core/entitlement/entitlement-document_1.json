{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Document 1",
  "type": "object",
  "required": [
    "Entitlement"
  ],
  "additionalProperties": false,
  "properties": {
    "Entitlement": {
      "type": "object",
      "required": [
        "FormatVersion",
        "EntitlementId",
        "Issuer",
        "LicensingScope",
        "Subject",
        "Components"
      ],
      "additionalProperties": false,
      "properties": {
        "FormatVersion": {
          "const": 1
        },
        "EntitlementId": {
          "type": "string",
          "minLength": 1
        },
        "Issuer": {
          "type": "object",
          "required": [
            "Id"
          ],
          "additionalProperties": true,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "Subject": {
          "type": "object",
          "required": [
            "Id"
          ],
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            },
            "DisplayName": {
              "type": "string"
            },
            "Attributes": {
              "type": "object"
            }
          }
        },
        "Components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Grants"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Capability",
                    "Permissions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Capability": {
                      "type": "object",
                      "required": [
                        "Id",
                        "Version"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "Id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "Version": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "Permissions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "Id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "Id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "ValidFrom": {
                            "type": "string"
                          },
                          "ValidUntil": {
                            "type": "string"
                          },
                          "Constraints": {
                            "type": "object"
                          },
                          "Metadata": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "IssuedAt": {
          "type": "string"
        },
        "ValidFrom": {
          "type": "string"
        },
        "ValidUntil": {
          "type": "string"
        },
        "Metadata": {
          "type": "object"
        },
        "IssuedForRequest": {
          "type": "object",
          "required": [
            "RequestId",
            "RequestDigest"
          ],
          "additionalProperties": false,
          "properties": {
            "RequestId": {
              "type": "string",
              "minLength": 1
            },
            "RequestDigest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "LicensingScope": {
          "type": "object",
          "required": [
            "Type"
          ],
          "additionalProperties": false,
          "properties": {
            "Type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.entitlement-document",
  "x-aac-schema-version": 1
}
