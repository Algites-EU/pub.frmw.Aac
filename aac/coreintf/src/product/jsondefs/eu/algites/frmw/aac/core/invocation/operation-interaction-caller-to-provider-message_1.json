{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.operation-interaction-caller-to-provider-message",
  "x-aac-schema-version": 1,
  "title": "Operation Interaction Caller To Provider Message 1",
  "type": "object",
  "required": [
    "LastAcceptedStateResultRevision",
    "InteractionMode",
    "CancellationRequested",
    "DetailLevel",
    "FailureDetailLevel",
    "StateResultDeliveryMode",
    "StateResultRequestId"
  ],
  "additionalProperties": false,
  "properties": {
    "LastAcceptedStateResultRevision": {
      "type": "integer",
      "minimum": 0
    },
    "InteractionMode": {
      "enum": [
        "foreground",
        "background"
      ]
    },
    "CancellationRequested": {
      "type": "boolean"
    },
    "DetailLevel": {
      "enum": [
        "summary",
        "detailed"
      ]
    },
    "ReportingIntervalMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "FailureDetailLevel": {
      "enum": [
        "basic",
        "stack_trace"
      ]
    },
    "StateResultDeliveryMode": {
      "enum": [
        "on_demand_complete",
        "on_demand_delta",
        "on_change_complete",
        "on_change_delta",
        "always_complete"
      ]
    },
    "StateResultRequestId": {
      "type": "integer",
      "minimum": 0
    }
  }
}
