{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.frmw.Aac/main/aac/coreintf/src/product/jsondefs/eu/algites/frmw/aac/core/presentation/display-content_1.jsondef.schema.json",
  "x-aac-schema-id": "_AAC.schema.display-content",
  "x-aac-schema-version": 1,
  "title": "Display Content 1",
  "description": "Defines the canonical Display Content schema and its serialized data contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Content": {
      "type": "string",
      "description": "Human-readable display content.",
      "minLength": 1
    },
    "ResourceKey": {
      "type": "string",
      "description": "Optional localization resource key for the human-readable text.",
      "minLength": 1
    },
    "Format": {
      "enum": [
        "plain_text",
        "markdown",
        "html"
      ],
      "description": "Serialization or presentation format of this display content.",
      "default": "plain_text"
    },
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "Optional absolute URI of the schema describing this root document."
    }
  },
  "anyOf": [
    {
      "required": [
        "Content"
      ]
    },
    {
      "required": [
        "ResourceKey"
      ]
    }
  ],
  "x-algites-schema-id": "eu.algites.frmw.aac.core.presentation.display-content",
  "x-algites-schema-version": 1
}
