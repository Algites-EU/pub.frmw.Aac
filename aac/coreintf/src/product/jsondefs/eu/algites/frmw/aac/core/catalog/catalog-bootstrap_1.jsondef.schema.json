{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "CatalogBootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "CatalogBootstrap": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "ProductId",
        "TechnologyId"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": {
          "const": 1
        },
        "ProductId": {
          "type": "string",
          "minLength": 1
        },
        "TechnologyId": {
          "type": "string",
          "minLength": 1
        },
        "Sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type",
              "Uri"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Uri": {
                "type": "string",
                "minLength": 1
              },
              "AuthenticationProfileId": {
                "type": "string",
                "minLength": 1
              },
              "Priority": {
                "type": "integer"
              },
              "Settings": {
                "type": "object"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "Metadata": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.catalog-bootstrap",
  "x-aac-schema-version": 1
}
