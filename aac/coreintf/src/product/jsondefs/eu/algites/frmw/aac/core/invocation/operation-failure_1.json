{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.operation-failure",
  "x-aac-schema-version": 1,
  "title": "Operation Failure 1",
  "type": "object",
  "required": [
    "system_message",
    "exception_type"
  ],
  "additionalProperties": false,
  "$defs": {
    "display_text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "resource_key"
          ]
        }
      ]
    }
  },
  "properties": {
    "system_message": {
      "type": "string",
      "minLength": 1
    },
    "user_message": {
      "anyOf": [
        {
          "$ref": "#/$defs/display_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "exception_type": {
      "type": "string",
      "minLength": 1
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "stack_trace": {
      "type": [
        "string",
        "null"
      ]
    },
    "extension": {},
    "details": {
      "type": "object"
    }
  }
}
