{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.operation-failure",
  "x-aac-schema-version": 1,
  "title": "Operation Failure 1",
  "type": "object",
  "required": [
    "SystemMessage",
    "ExceptionType"
  ],
  "additionalProperties": false,
  "$defs": {
    "display_text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Text": {
          "type": "string",
          "minLength": 1
        },
        "ResourceKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "Text"
          ]
        },
        {
          "required": [
            "ResourceKey"
          ]
        }
      ]
    }
  },
  "properties": {
    "SystemMessage": {
      "type": "string",
      "minLength": 1
    },
    "UserMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/display_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "ExceptionType": {
      "type": "string",
      "minLength": 1
    },
    "ErrorCode": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "StackTrace": {
      "type": [
        "string",
        "null"
      ]
    },
    "Extension": {},
    "Details": {
      "type": "object"
    }
  }
}
