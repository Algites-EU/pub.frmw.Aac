{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Security Bootstrap 1",
  "type": "object",
  "required": [
    "SecurityBootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "SecurityBootstrap": {
      "type": "object",
      "required": [
        "SchemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": {
          "const": 1
        },
        "SecretProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Settings": {
                "type": "object"
              },
              "BootstrapSafe": {
                "type": "boolean"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "AuthenticationProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Mechanism"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Mechanism": {
                "type": "string",
                "minLength": 1
              },
              "Parameters": {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "SecretReference"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "SecretReference": {
                          "type": "object",
                          "required": [
                            "SecretProviderId",
                            "Key"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "SecretProviderId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "Key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "Version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "Metadata": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "Metadata": {
                "type": "object"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "Metadata": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.security-bootstrap",
  "x-aac-schema-version": 1
}
