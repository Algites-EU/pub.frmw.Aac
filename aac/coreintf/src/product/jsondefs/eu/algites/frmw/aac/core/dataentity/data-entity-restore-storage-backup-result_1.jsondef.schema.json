{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-restore-storage-backup-result",
  "x-aac-schema-version": 1,
  "title": "Data Entity Restore Storage Backup Result 1",
  "type": "object",
  "required": [
    "Restored",
    "BackupFile",
    "Mode",
    "SchemaVersionCount",
    "RecordCount"
  ],
  "additionalProperties": false,
  "properties": {
    "Restored": {
      "type": "boolean"
    },
    "BackupFile": {
      "type": "string",
      "minLength": 1
    },
    "Mode": {
      "enum": [
        "empty_only",
        "replace_all"
      ]
    },
    "SchemaVersionCount": {
      "type": "integer",
      "minimum": 0
    },
    "RecordCount": {
      "type": "integer",
      "minimum": 0
    },
    "Metadata": {
      "type": "object"
    }
  }
}
