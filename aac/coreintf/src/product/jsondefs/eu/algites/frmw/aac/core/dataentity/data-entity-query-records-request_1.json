{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-query-records-request",
  "x-aac-schema-version": 1,
  "title": "Data Entity Query Records Request 1",
  "type": "object",
  "required": [
    "schema_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACTIVE",
          "TOMBSTONE"
        ]
      },
      "default": [
        "ACTIVE"
      ]
    },
    "uids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "object",
            "required": [
              "schema_id",
              "uid"
            ],
            "additionalProperties": false,
            "properties": {
              "schema_id": {
                "type": "string",
                "minLength": 1
              },
              "uid": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "schema_path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 1
    },
    "reference_match": {
      "enum": [
        "ALL",
        "ANY"
      ],
      "default": "ALL"
    },
    "order": {
      "enum": [
        "UID_ASC",
        "UID_DESC"
      ],
      "default": "UID_ASC"
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "continuation_token": {
      "type": "string",
      "minLength": 1
    },
    "stored_schema_version_filter": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    }
  }
}
