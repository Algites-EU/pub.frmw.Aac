{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.data-entity-query-records-request",
  "x-aac-schema-version": 1,
  "title": "Data Entity Query Records Request 1",
  "type": "object",
  "required": [
    "SchemaId"
  ],
  "additionalProperties": false,
  "properties": {
    "SchemaId": {
      "type": "string",
      "minLength": 1
    },
    "States": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "active",
          "tombstone"
        ]
      },
      "default": [
        "active"
      ]
    },
    "Uids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "References": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Target"
        ],
        "additionalProperties": false,
        "properties": {
          "Target": {
            "type": "object",
            "required": [
              "SchemaId",
              "Uid"
            ],
            "additionalProperties": false,
            "properties": {
              "SchemaId": {
                "type": "string",
                "minLength": 1
              },
              "Uid": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "SchemaPath": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "minItems": 1
    },
    "ReferenceMatch": {
      "enum": [
        "all",
        "any"
      ],
      "default": "all"
    },
    "Order": {
      "enum": [
        "uid_asc",
        "uid_desc"
      ],
      "default": "uid_asc"
    },
    "Limit": {
      "type": "integer",
      "minimum": 1
    },
    "ContinuationToken": {
      "type": "string",
      "minLength": 1
    },
    "StoredSchemaVersionFilter": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    }
  }
}
