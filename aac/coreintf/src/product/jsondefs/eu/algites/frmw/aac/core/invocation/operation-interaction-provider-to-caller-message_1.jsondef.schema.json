{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.operation-interaction-provider-to-caller-message",
  "x-aac-schema-version": 1,
  "title": "Operation Interaction Provider To Caller Message 1",
  "type": "object",
  "required": [
    "InteractionRevision",
    "ExecutionState",
    "StateResultRevision",
    "Events",
    "Features"
  ],
  "additionalProperties": false,
  "properties": {
    "InteractionRevision": {
      "type": "integer",
      "minimum": 0
    },
    "ExecutionState": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "StateResultRevision": {
      "type": "integer",
      "minimum": 0
    },
    "StateResultPayloadRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "StateResult": {},
    "Events": {
      "type": "array",
      "items": {
        "$ref": "operation-interaction-event_1.jsondef.schema.json"
      }
    },
    "Features": {
      "type": "object",
      "required": [
        "ProgressReporting",
        "Cancellation",
        "DetailLevel",
        "ReportingInterval",
        "SupportedStateResultDeliveryModes"
      ],
      "additionalProperties": false,
      "properties": {
        "ProgressReporting": {
          "type": "boolean"
        },
        "Cancellation": {
          "type": "boolean"
        },
        "DetailLevel": {
          "type": "boolean"
        },
        "ReportingInterval": {
          "type": "boolean"
        },
        "SupportedStateResultDeliveryModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "on_demand_complete",
              "on_demand_delta",
              "on_change_complete",
              "on_change_delta",
              "always_complete"
            ]
          }
        }
      }
    }
  }
}
