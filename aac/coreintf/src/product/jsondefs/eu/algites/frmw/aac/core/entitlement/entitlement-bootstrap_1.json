{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Bootstrap 1",
  "type": "object",
  "required": [
    "entitlement_bootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "entitlement_bootstrap": {
      "type": "object",
      "required": [
        "schema_version",
        "default_entitlement_profile",
        "entitlement_profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "default_entitlement_profile": {
          "type": "string",
          "minLength": 1
        },
        "entitlement_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "version",
              "licensing_scopes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              },
              "licensing_scopes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "resolver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resolver": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mandatory": {
                      "type": "boolean"
                    },
                    "entitlement_providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "description": {
                      "$ref": "#/$defs/displayText"
                    }
                  }
                }
              }
            }
          }
        },
        "entitlement_providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "metadata": {
          "type": "object"
        },
        "trusted_issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "issuer_id"
            ],
            "additionalProperties": false,
            "properties": {
              "issuer_id": {
                "type": "string",
                "minLength": 1
              },
              "component_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_types": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "signer_identities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "licensing_scope_resolvers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              },
              "name": {
                "$ref": "#/$defs/displayText"
              },
              "description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "resource_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "resource_key"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.entitlement-bootstrap",
  "x-aac-schema-version": 1
}
