{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Bootstrap 1",
  "type": "object",
  "required": [
    "EntitlementBootstrap"
  ],
  "additionalProperties": false,
  "properties": {
    "EntitlementBootstrap": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "DefaultEntitlementProfile",
        "EntitlementProfiles"
      ],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": {
          "const": 1
        },
        "DefaultEntitlementProfile": {
          "type": "string",
          "minLength": 1
        },
        "EntitlementProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Version",
              "LicensingScopes"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Version": {
                "type": "integer",
                "minimum": 1
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              },
              "LicensingScopes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Id",
                    "Type",
                    "Resolver"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Resolver": {
                      "type": "string",
                      "minLength": 1
                    },
                    "Mandatory": {
                      "type": "boolean"
                    },
                    "EntitlementProviders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "Id"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "Id": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    "Name": {
                      "$ref": "#/$defs/displayText"
                    },
                    "Description": {
                      "$ref": "#/$defs/displayText"
                    }
                  }
                }
              }
            }
          }
        },
        "EntitlementProviders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Settings": {
                "type": "object"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        },
        "Metadata": {
          "type": "object"
        },
        "TrustedIssuers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "IssuerId"
            ],
            "additionalProperties": false,
            "properties": {
              "IssuerId": {
                "type": "string",
                "minLength": 1
              },
              "ComponentIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "EvidenceTypes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "SignerIdentities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "LicensingScopeResolvers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Type"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "Type": {
                "type": "string",
                "minLength": 1
              },
              "Settings": {
                "type": "object"
              },
              "Name": {
                "$ref": "#/$defs/displayText"
              },
              "Description": {
                "$ref": "#/$defs/displayText"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "displayText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Text": {
              "type": "string",
              "minLength": 1
            },
            "ResourceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "Text"
              ]
            },
            {
              "required": [
                "ResourceKey"
              ]
            }
          ]
        }
      ]
    }
  },
  "x-aac-schema-id": "_AAC.schema.entitlement-bootstrap",
  "x-aac-schema-version": 1
}
