{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_AAC.schema.workspace-component-requirements/1",
  "type": "object",
  "required": [
    "WorkspaceComponentRequirements"
  ],
  "additionalProperties": false,
  "properties": {
    "WorkspaceComponentRequirements": {
      "type": "object",
      "required": [
        "WorkspaceId",
        "Requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "WorkspaceId": {
          "type": "string",
          "minLength": 1
        },
        "UpdatePolicy": {
          "enum": [
            "manual",
            "notify",
            "auto_compatible",
            "auto_locked"
          ],
          "default": "manual"
        },
        "Requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ComponentId"
            ],
            "additionalProperties": false,
            "properties": {
              "ComponentId": {
                "type": "string",
                "minLength": 1
              },
              "Versions": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "uniqueItems": true
              },
              "Required": {
                "type": "boolean",
                "default": true
              },
              "SourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "Name": {},
              "Description": {}
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.workspace-component-requirements",
  "x-aac-schema-version": 1
}
