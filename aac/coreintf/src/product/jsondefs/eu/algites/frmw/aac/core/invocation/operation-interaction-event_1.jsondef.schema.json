{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-aac-schema-id": "_AAC.schema.operation-interaction-event",
  "x-aac-schema-version": 1,
  "title": "Operation Interaction Event 1",
  "type": "object",
  "required": [
    "EventType"
  ],
  "additionalProperties": false,
  "$defs": {
    "display_text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Text": {
          "type": "string",
          "minLength": 1
        },
        "ResourceKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "Text"
          ]
        },
        {
          "required": [
            "ResourceKey"
          ]
        }
      ]
    }
  },
  "properties": {
    "EventType": {
      "enum": [
        "status",
        "progress",
        "detail",
        "diagnostic"
      ]
    },
    "ProgressId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "ParentProgressId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "PhaseId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "Name": {
      "anyOf": [
        {
          "$ref": "#/$defs/display_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "Description": {
      "anyOf": [
        {
          "$ref": "#/$defs/display_text"
        },
        {
          "type": "null"
        }
      ]
    },
    "Current": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "Total": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "Unit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "Code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "Details": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "EventType": {
            "const": "progress"
          }
        },
        "required": [
          "EventType"
        ]
      },
      "then": {
        "required": [
          "ProgressId"
        ]
      }
    }
  ]
}
