{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Issuing Request 1",
  "description": "Defines the canonical AAC Entitlement Issuing Request schema and its serialized data contract.",
  "type": "object",
  "required": [
    "EntitlementRequest"
  ],
  "additionalProperties": false,
  "properties": {
    "EntitlementRequest": {
      "type": "object",
      "description": "Requested entitlement data supplied to an entitlement issuer.",
      "required": [
        "FormatVersion",
        "RequestId",
        "RequestedLicensingScope",
        "Subject",
        "Components"
      ],
      "additionalProperties": false,
      "properties": {
        "FormatVersion": {
          "const": 1,
          "description": "Version of the persisted or exchanged document format."
        },
        "RequestId": {
          "type": "string",
          "description": "Stable identifier of the request associated with this entitlement request.",
          "minLength": 1
        },
        "Subject": {
          "type": "object",
          "description": "Structured subject associated with this entitlement request.",
          "required": [
            "Id"
          ],
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "description": "Stable identifier of this subject.",
              "minLength": 1
            },
            "DisplayName": {
              "type": "string",
              "description": "Specifies the display name for this subject."
            },
            "Attributes": {
              "type": "object",
              "description": "Structured attributes associated with this subject."
            }
          }
        },
        "Components": {
          "type": "array",
          "description": "Lists the components associated with this entitlement request.",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "RequestedGrants"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "description": "Stable identifier of this component.",
                "minLength": 1
              },
              "RequestedGrants": {
                "type": "array",
                "description": "Lists the requested grants associated with this component.",
                "items": {
                  "type": "object",
                  "required": [
                    "Capability",
                    "Permissions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Capability": {
                      "type": "object",
                      "description": "Identity and human-facing metadata of the capability contract.",
                      "required": [
                        "Id",
                        "Version"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "Id": {
                          "type": "string",
                          "description": "Stable identifier of this capability.",
                          "minLength": 1
                        },
                        "Version": {
                          "type": "integer",
                          "description": "Version of this capability.",
                          "minimum": 1
                        }
                      }
                    },
                    "Permissions": {
                      "type": "array",
                      "description": "Authorization or entitlement permissions associated with this requested grant.",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "GeneratedAt": {
          "type": "string",
          "description": "Specifies the generated at for this entitlement request."
        },
        "Metadata": {
          "type": "object",
          "description": "Additional structured metadata associated with this entitlement request."
        },
        "RequestDigest": {
          "type": "string",
          "description": "Specifies the request digest for this entitlement request.",
          "minLength": 1
        },
        "RequestedLicensingScope": {
          "type": "object",
          "description": "Structured requested licensing scope associated with this entitlement request.",
          "required": [
            "Type"
          ],
          "additionalProperties": false,
          "properties": {
            "Type": {
              "type": "string",
              "description": "Type discriminator for this requested licensing scope.",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.entitlement-issuing-request",
  "x-aac-schema-version": 1
}
