{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAC Entitlement Issuing Request 1",
  "type": "object",
  "required": [
    "EntitlementRequest"
  ],
  "additionalProperties": false,
  "properties": {
    "EntitlementRequest": {
      "type": "object",
      "required": [
        "FormatVersion",
        "RequestId",
        "RequestedLicensingScope",
        "Subject",
        "Components"
      ],
      "additionalProperties": false,
      "properties": {
        "FormatVersion": {
          "const": 1
        },
        "RequestId": {
          "type": "string",
          "minLength": 1
        },
        "Subject": {
          "type": "object",
          "required": [
            "Id"
          ],
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            },
            "DisplayName": {
              "type": "string"
            },
            "Attributes": {
              "type": "object"
            }
          }
        },
        "Components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "RequestedGrants"
            ],
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "minLength": 1
              },
              "RequestedGrants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Capability",
                    "Permissions"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "Capability": {
                      "type": "object",
                      "required": [
                        "Id",
                        "Version"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "Id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "Version": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "Permissions": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "GeneratedAt": {
          "type": "string"
        },
        "Metadata": {
          "type": "object"
        },
        "RequestDigest": {
          "type": "string",
          "minLength": 1
        },
        "RequestedLicensingScope": {
          "type": "object",
          "required": [
            "Type"
          ],
          "additionalProperties": false,
          "properties": {
            "Type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "x-aac-schema-id": "_AAC.schema.entitlement-issuing-request",
  "x-aac-schema-version": 1
}
